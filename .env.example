# Copy to .env for local overrides. Never commit .env -- it is gitignored.
# All settings are prefixed RXIQ_ (see apps/api/src/rxiq/config.py).

RXIQ_ENVIRONMENT=local
RXIQ_DEBUG=true

RXIQ_API_HOST=127.0.0.1
RXIQ_API_PORT=8000

# Storage. DuckDB is the warehouse; SQLite holds app state. Both move to Postgres at
# Phase 9 by changing these values only.
# RXIQ_WAREHOUSE_PATH=data/rxiq.duckdb
# RXIQ_APP_DATABASE_URL=sqlite:///data/app.sqlite

# Domain defaults. Overriding any of these is a domain decision -- see the justification
# on each field in config.py before changing one.
# RXIQ_NBRX_LOOKBACK_MONTHS=12
# RXIQ_PEER_TARGET_PERCENTILE=75
# RXIQ_MIN_PEER_COHORT_SIZE=30

# Phase 8. Never commit a real key.
# ANTHROPIC_API_KEY=
